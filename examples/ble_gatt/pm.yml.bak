mcuboot:
  address: 0x0
  size: 0xc000
  region: flash_primary

mcuboot_primary:
  address: 0xc000
  size: 0xec000
  region: flash_primary

settings_storage:
  address: 0xf8000
  size: 0x8000
  region: flash_primary

mcuboot_secondary:
  address: 0x0
  size: 0xec000
  region: external_flash

littlefs_storage:
  address: 0xec000
  size: 0x100000
  region: external_flash

# The LittleFS storage partition
storage:
  address: 0xec000
  size: 0x114000
  region: external_flash
