/ {
	fstab {
		compatible = "zephyr,fstab";
		lfs1: lfs1 {
			compatible = "zephyr,fstab,littlefs";
			mount-point = "/lfs1";
			partition = <&storage_partition>;
			automount;
			read-size = <16>;
			prog-size = <16>;
			cache-size = <64>;
			lookahead-size = <32>;
			block-cycles = <512>;
		};
	};
};

/* Enable I2C1 for pH2 sensor (Mikroe pH2 Click with MCP3221) */
&i2c1 {
	status = "okay";
};

/* DS18B20 single-wire temperature sensor: data line on D0 (P0.02) on XIAO BLE.
 * Use a 4.7kΩ pull-up from data to 3.3V. If no sensor is connected you will see
 * "No 1-Wire slaves connected" and temp reads will fail (err -19).
 */
/ {
	w1: w1 {
		compatible = "zephyr,w1-gpio";
		gpios = <&gpio0 2 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN | GPIO_PULL_UP)>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";

		ds18b20: ds18b20@0 {
			compatible = "maxim,ds18b20";
			reg = <0>;
			family-code = <0x28>;
			resolution = <12>;
			status = "okay";
		};
	};

	aliases {
		temp0 = &ds18b20;
	};
};
